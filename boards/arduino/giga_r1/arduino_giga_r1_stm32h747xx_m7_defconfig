# Disable the internal SMPS regulator
CONFIG_POWER_SUPPLY_DIRECT_SMPS=n

# Enable GPIO
CONFIG_GPIO=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable HW stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable uart driver
CONFIG_SERIAL=y

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Use zephyr,code-partition as flash offset
CONFIG_USE_DT_CODE_PARTITION=y

# Enable DFSDM
CONFIG_DFSDM_STM32=y
CONFIG_DFSDM=y

# Enable DMA
CONFIG_DMA=y

# DISABLE BANNER -> related to DFSDM (it outputs on serial and
# make noise when you try to use the microphone)
CONFIG_BOOT_BANNER=n
