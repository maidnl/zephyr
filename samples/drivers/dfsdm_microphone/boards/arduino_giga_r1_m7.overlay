#include <zephyr/dt-bindings/clock/stm32h7_clock.h>
#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>


/* * PART 1: Define the Missing Hardware Node
 * We use the path "/ { soc { ... } }" instead of "&soc" to be safe.
 */
/ {
    soc {
        dfsdm1: dfsdm@40017000 {
            compatible = "st,stm32-dfsdm";
            reg = <0x40017000 0x400>; /* 1KB register space */

	    /* bit 28 enable DFSDM */
            clocks = <&rcc STM32_CLOCK_BUS_APB2 0x10000000>;

            interrupts = <110 0>, <111 0>, <112 0>, <113 0>;
            interrupt-names = "flt0", "flt1", "flt2", "flt3";

            #address-cells = <1>;
            #size-cells = <1>;

            status = "disabled";
        };
    };

    /* USB */
    chosen {
	zephyr,console = &board_cdc_acm_uart;
	zephyr,shell-uart = &board_cdc_acm_uart;
    };
};


&clk_hse {
	status = "okay";
	clock-frequency = <DT_FREQ_M(16)>;
};

&clk_lse {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	div-m = <2>;
	mul-n = <120>;
	div-p = <2>;
	div-q = <4>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
};

&pinctrl {
    dfsdm1_clk_pd3: dfsdm1_clk_pd3 {
        pinmux = <STM32_PINMUX('D', 3, AF3)>; /* DFSDM1_CKOUT */
        bias-disable;
        slew-rate = "very-high-speed";
    };

    dfsdm1_dat_pc1: dfsdm1_dat_pc1 {
        pinmux = <STM32_PINMUX('C', 1, AF3)>; /* DFSDM1_DATIN0 */
        bias-disable;
    };
};

&dfsdm1 {
    status = "okay";
    pinctrl-0 = <&dfsdm1_clk_pd3 &dfsdm1_dat_pc1>;
    pinctrl-names = "default";

    /* Define the specific filter we want to use */
    dfsdm1_flt0: filter@0 {
        compatible = "st,stm32-dfsdm-filter";
        reg = <0x0 0x100>; /* Offset 0 for FLT0 */

        interrupts = <110 0>;

        /* DMA Config for H7 (DMAMUX)
         * Request 101 = DFSDM1_FLT0
         */
        dmas = <&dmamux1 0 101 0x400>;
        dma-names = "rx";

        status = "okay";
        label = "PDM_MIC_0";
    };
};

/* Enable the DMA Multiplexer */
&dmamux1 {
	    status = "okay";
};

/* Enable the underlying DMA controllers (if not already enabled by board) */
&dma1 {
	    status = "okay";
};

&dma2 {
	    status = "okay";
};
